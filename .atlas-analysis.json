  "keyFeatures": [
    "Mobile vault for secure personal document storage",
    "Business portal for enterprise document exchange",
    "KYC (Know Your Customer) identity verification",
    "KYB (Know Your Business) company verification",
    "Diploma and academic credential verification",
    "Civil status document verification",
    "Secure document request and delivery between businesses and individuals",
    "REST API for seamless enterprise integration",
    "Webhook notifications for real-time verification status updates"
  ],
  "publicApiSurface": [
    "POST /verifications — initiate a KYC, KYB, or document verification",
    "GET /verifications/{id} — retrieve verification status and result",
    "GET /verifications — list verifications for your organization",
    "POST /documents/request — request a document from a Trayce vault holder",
    "POST /documents/send — send a document to a recipient",
    "GET /documents/{id} — retrieve a document or its metadata",
    "POST /webhooks — register a webhook endpoint",
    "GET /webhooks/events — list available webhook event types"
  ]
